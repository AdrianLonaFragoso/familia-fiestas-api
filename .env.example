# Copia este archivo a .env y pega las cadenas de conexión de Neon.
# - DATABASE_URL: cadena con "-pooler" en el host. La usa la API en runtime.
# - DIRECT_URL: cadena directa (sin pooler). La usa Prisma CLI para migraciones.

NODE_ENV="development"
PORT=3000

DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clave que deben enviar los organizadores en el header X-Admin-Key.
# Genera una cadena larga y aleatoria; no la compartas fuera del equipo.
ADMIN_API_KEY="cambia-esta-clave-por-una-larga-y-aleatoria"

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS="http://localhost:8080"

# Opcionales
LOG_LEVEL="info"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
